<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VSProjectRenamer</RootNamespace>
    <AssemblyName>vsrename</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vsrename</ToolCommandName>
    <PackageId>VSProjectRenamer</PackageId>
    <Version>1.0.0</Version>
    <Authors>winproxy</Authors>
    <Description>A .NET global tool that renames and clones entire projects — generates 12 naming convention variants, replaces across 60+ file types, randomizes ports, regenerates GUIDs, and restores packages.</Description>
    <PackageTags>dotnet;dotnet-tool;rename;clone;abp;abpio;aspnet-core;angular;blazor;react-native;project-template;refactoring;cli-tool;csharp</PackageTags>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

</Project>
